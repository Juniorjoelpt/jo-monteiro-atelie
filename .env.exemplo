# Copie para .env e troque todos os valores
DB_PASSWORD=troque-por-uma-senha-forte
DB_ROOT_PASSWORD=troque-por-outra-senha-forte
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres
# Usuária criada no primeiro start (a senha pode ser trocada depois em Configurações)
ADMIN_NOME=Jô Monteiro
ADMIN_EMAIL=jo@seudominio.com.br
ADMIN_SENHA=senha-inicial-forte
# Porta local da VPS que o Nginx vai usar (escolha uma livre)
APP_PORTA=8086
# Endereço do site, usado nos links de certificado enviados às alunas
URL_PUBLICA=https://jomonteiroatelie.com.br
